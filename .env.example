# Copy to .env.local for local development (never committed), and put the
# same values in Vercel → Project → Settings → Environment Variables.
# Only the first block is required for the app to start.

# --- Required ----------------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# The public address of the app. Links in emails, SMS and webhooks use it.
APP_URL=http://localhost:3000

# --- Models ------------------------------------------------------------------
# Calls, transcription and the AI on the phone go straight to OpenAI.
OPENAI_API_KEY=sk-...
# Everything else (Maya, memory, website reading, intake) goes through the
# Vercel AI Gateway: OIDC on Vercel, this key locally. Or set the *_PROVIDER
# variables to "openai" to use OPENAI_API_KEY instead.
AI_GATEWAY_API_KEY=
# RECEPTIONIST_MODEL_PROVIDER=openai
# MEMORY_MODEL_PROVIDER=openai
# EMBEDDING_PROVIDER=openai

# --- Receptionist: phone and SMS (docs/RECEPTIONIST.md §3.2) -----------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_COUNTRY=NO
# Regulatory bundle for Norwegian numbers (Twilio console → Regulatory Compliance)
TWILIO_BUNDLE_SID=BU...
TWILIO_ADDRESS_SID=AD...
# Sender for alerts to the owner: a number or a name of up to 11 characters
TWILIO_NOTIFY_FROM=Humanframe

# --- Receptionist: the AI on the phone (docs/RECEPTIONIST.md §3.3) -----------
# OpenAI → Project settings: the project id, and the signing secret of the
# webhook that points at https://<app>/api/telephony/openai
OPENAI_PROJECT_ID=proj_...
OPENAI_WEBHOOK_SECRET=whsec_...
# PHONE_MODEL=gpt-realtime
# PHONE_VOICE=marin

# --- Calendar and email (Composio) -------------------------------------------
CONNECTORS_ENABLED=true
NEXT_PUBLIC_CONNECTORS_ENABLED=true
COMPOSIO_API_KEY=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=ac_...
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=

# --- Email to the owner and the weekly report (Resend) ------------------------
RESEND_API_KEY=re_...
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_FROM=Humanframe <varsel@ditt-domene.no>
# NOTIFICATIONS_ALLOWLIST=casper@nagsoftware.no

# --- Schedules ---------------------------------------------------------------
# Any long random string: openssl rand -hex 32
CRON_SECRET=

# --- Optional: Maya's browser call, FaceTime prototype, Stripe ----------------
# NEXT_PUBLIC_MAYA_RUNTIME=eve
# CALL_ENABLED=true
# NEXT_PUBLIC_CALL_ENABLED=true
# BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# (STRIPE_PRICE_* are printed by `pnpm stripe:setup`)
